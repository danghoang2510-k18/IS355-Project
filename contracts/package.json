{
  "name": "dsct-contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat compile && node scripts/export-abi.mjs",
    "test": "hardhat test mocha",
    "typecheck": "hardhat compile && tsc --noEmit",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "export:abi": "node scripts/export-abi.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "4.0.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "22.15.30",
    "chai": "5.1.2",
    "ethers": "6.17.0",
    "hardhat": "3.21.1",
    "mocha": "12.0.0",
    "typescript": "5.9.3"
  }
}
